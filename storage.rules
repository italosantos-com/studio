rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Permite leitura pública de todos os arquivos
    match /{allPaths=**} {
      allow read;
    }

    // Permite a escrita (upload) pública apenas na pasta 'general-uploads'
    match /general-uploads/{allPaths=**} {
      allow write: if true;
    }

    // A pasta de autenticação facial é gerenciada pelo Firebase Admin SDK no servidor
    // Não permite acesso direto do cliente para segurança
    match /italosantos.com/facial-auth-users/{allPaths=**} {
      allow write: if false; // Only server-side writes via Admin SDK
    }
  }
}
